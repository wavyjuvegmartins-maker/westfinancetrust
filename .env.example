# -----------------------------------------------------------------------------
# West Finance Trust environment variables
#
# Copy this file to .env.local and fill in the values. .env.local is ignored
# by git; never commit real keys. Restart `npm run dev` after changing it.
# -----------------------------------------------------------------------------

# --- Supabase -----------------------------------------------------------------
# Dashboard -> Project Settings -> API Keys (and Data API for the URL).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (starts sb_publishable_). On older projects this is the
# "anon" key. Safe in the browser: row level security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret key" (starts sb_secret_). On older projects this is the
# "service_role" key. SERVER ONLY: it bypasses row level security. Used to
# register customers, look up login IDs and send credentials. Never prefix it
# with NEXT_PUBLIC_ and never paste it into client code.
SUPABASE_SECRET_KEY=

# --- Email --------------------------------------------------------------------
# Login details, account and security alerts, contact-form and waitlist emails.
# While RESEND_API_KEY is empty nothing is sent: in development each email is
# printed in the terminal running `npm run dev` instead.
#
# https://resend.com -> API Keys. Verify your sending domain in Resend first.
RESEND_API_KEY=

# The sender customers see. Must use the domain verified in Resend.
EMAIL_FROM="West Finance Trust <no-reply@westfinacetrust.com>"

# Where contact-form messages are forwarded (staff reply straight from there).
# Empty means the support address in src/lib/site.ts.
STAFF_EMAIL=

# Protects /api/cron/emails, which Supabase calls every 5 minutes to send the
# alerts made by the scheduled jobs (supabase/setup/04_email_job.sql).
# Any long random string, e.g. from: openssl rand -hex 32
CRON_SECRET=

# --- App ------------------------------------------------------------------------
# Public address of the site, used for the login link in emails.
# http://localhost:3000 locally; your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
